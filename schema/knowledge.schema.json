{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/assistantmy47-prog/CopilotKB/blob/main/schema/knowledge.schema.json",
  "title": "CopilotKB knowledge register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "updated_at",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "record_type",
        "project",
        "description",
        "status",
        "owner",
        "event_date",
        "source_chat",
        "source_link",
        "last_reviewed",
        "review_status",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Stable UUID; preserve across revisions"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "record_type": {
          "type": "string",
          "enum": [
            "Decision",
            "Action",
            "Risk",
            "Issue",
            "Fact"
          ]
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "Proposed",
            "Confirmed",
            "Closed",
            "Superseded"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "source_chat": {
          "type": "string",
          "minLength": 1
        },
        "source_link": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "last_reviewed": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "review_status": {
          "type": "string",
          "enum": [
            "Pending Review",
            "Verified",
            "Rejected"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "due_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "related_record_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
